# Supabase Environment Variables
# Trong môi trường Vite (ứng dụng hiện tại), dùng prefix VITE_
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Gemini API Key for server-side calculations
GEMINI_API_KEY=

# MÔI TRƯỜNG NEXT.JS:
# Nếu bạn chuyển mã nguồn này sang Next.js, hãy đổi tên file thành .env.local và dùng prefix NEXT_PUBLIC_
# NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
